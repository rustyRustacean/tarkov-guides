@echo off
setlocal EnableDelayedExpansion
title MasterTarkov Companion - Setup

REM ============================================================
REM  MasterTarkov Companion - one-time setup (Windows 10 / 11)
REM  - Installs Python only if it is missing
REM  - Places companion.py in %APPDATA%
REM  - Registers the masttarkov:// launch protocol (per-user)
REM  No administrator rights required.
REM ============================================================

set "APPID=MasterTarkov-Companion"
set "INSTALL_DIR=%APPDATA%\%APPID%"
set "PROTOCOL=masttarkov"
REM Python version fetched only when no Python is found on the machine.
set "PYURL=https://www.python.org/ftp/python/3.12.7/python-3.12.7-amd64.exe"

echo(
echo   ==========================================
echo    MasterTarkov Companion - Setup
echo   ==========================================
echo(

if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%"

REM ---- 1. Locate a windowless Python (pythonw) ----
set "PYW="
for /f "delims=" %%p in ('where pythonw.exe 2^>nul') do if not defined PYW set "PYW=%%p"
if not defined PYW for /f "delims=" %%p in ('where pyw.exe 2^>nul') do if not defined PYW set "PYW=%%p"

if not defined PYW (
    echo   Python was not found. Downloading the official installer...
    set "PYSETUP=%TEMP%\python-mtc-setup.exe"
    powershell -NoProfile -Command "try { [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -Uri '%PYURL%' -OutFile '%TEMP%\python-mtc-setup.exe' } catch { exit 1 }"
    if not exist "%TEMP%\python-mtc-setup.exe" (
        echo(
        echo   ERROR: Could not download Python.
        echo   Please install Python 3.11+ from https://python.org  ^(tick "Add to PATH"^)
        echo   and run this setup again.
        echo(
        pause
        exit /b 1
    )
    echo   Installing Python quietly. This can take a minute...
    "%TEMP%\python-mtc-setup.exe" /quiet InstallAllUsers=0 PrependPath=1 Include_launcher=1 Include_test=0
    for /f "delims=" %%p in ('where pythonw.exe 2^>nul') do if not defined PYW set "PYW=%%p"
    if not defined PYW for /f "delims=" %%p in ('dir /b /s "%LOCALAPPDATA%\Programs\Python\pythonw.exe" 2^>nul') do if not defined PYW set "PYW=%%p"
)

if not defined PYW (
    echo(
    echo   Python is installed but this window has a stale PATH.
    echo   Close this window, open a NEW one, and run setup again.
    echo(
    pause
    exit /b 1
)
echo   Using Python: !PYW!

REM ---- 2. Unpack companion.py (embedded in this installer as base64) ----
REM No network fetch: the script lives in the `::B64:` lines at the bottom of
REM this file, so setup works offline and behind any login gate.
powershell -NoProfile -Command "$sb=[Text.StringBuilder]::new(); foreach($l in [IO.File]::ReadAllLines('%~f0')){ if($l.StartsWith('::B64:')){ [void]$sb.Append($l.Substring(6)) } }; if($sb.Length -eq 0){ exit 2 }; [IO.File]::WriteAllBytes('%INSTALL_DIR%\companion.py',[Convert]::FromBase64String($sb.ToString()))"
if not exist "%INSTALL_DIR%\companion.py" (
    echo   ERROR: Could not unpack companion.py from this installer.
    pause
    exit /b 1
)
echo   Installed companion.py

REM ---- 3. Generate a silent launcher (for manual start / testing) ----
> "%INSTALL_DIR%\launch.bat" echo @echo off
>> "%INSTALL_DIR%\launch.bat" echo start "" "!PYW!" "%INSTALL_DIR%\companion.py"
echo   Created launch.bat

REM ---- 4. Generate the uninstaller ----
> "%INSTALL_DIR%\uninstall.bat" echo @echo off
>> "%INSTALL_DIR%\uninstall.bat" echo title MasterTarkov Companion - Uninstall
>> "%INSTALL_DIR%\uninstall.bat" echo reg delete "HKCU\Software\Classes\%PROTOCOL%" /f ^>nul 2^>^&1
>> "%INSTALL_DIR%\uninstall.bat" echo rmdir /s /q "%INSTALL_DIR%"
>> "%INSTALL_DIR%\uninstall.bat" echo echo MasterTarkov Companion has been removed.
>> "%INSTALL_DIR%\uninstall.bat" echo pause
echo   Created uninstall.bat

REM ---- 5. Register the masttarkov:// protocol (points straight at pythonw) ----
reg add "HKCU\Software\Classes\%PROTOCOL%" /ve /d "URL:MasterTarkov Companion" /f >nul
reg add "HKCU\Software\Classes\%PROTOCOL%" /v "URL Protocol" /d "" /f >nul
reg add "HKCU\Software\Classes\%PROTOCOL%\shell\open\command" /ve /d "\"!PYW!\" \"%INSTALL_DIR%\companion.py\"" /f >nul
echo   Registered %PROTOCOL%:// launch protocol

REM ---- 6. Start it now so it's running immediately (windowless) ----
start "" "!PYW!" "%INSTALL_DIR%\companion.py"
echo   Companion started.

echo(
echo   ==========================================
echo    All set. You can close this window.
echo   ==========================================
echo(
echo   It's running now and starts on its own when you open the tracker.
echo   To remove it later, run:  %INSTALL_DIR%\uninstall.bat
echo(
timeout /t 8 >nul
exit /b 0

