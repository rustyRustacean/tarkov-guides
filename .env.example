# Required. Liveblocks secret key for collaborative Maps sessions
# (server-only, see src/app/api/maps-session/lib/liveblocks-server.ts).
# Without it the site still runs, but Collaborate sessions and teammate
# position markers won't work. Get one from https://liveblocks.io/dashboard.
LIVEBLOCKS_SECRET_KEY=

# Optional. The Event Scoreboard's public preset library moderation
# (see src/app/api/event-presets/). Each needs at least 32 characters; make
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# EVENTS_ADMIN_KEY is typed into /resources/events/admin to hide, restore or
# delete published presets; without it, moderation is off.
# EVENTS_REPORT_SECRET keys the HMAC that tells reporters apart without
# storing their IPs; without it, the Report button is off. Use two
# different values, and never reuse the Liveblocks key.
EVENTS_ADMIN_KEY=
EVENTS_REPORT_SECRET=

# Optional. Static-asset CDN origin for map images and PvP guide videos
# (see src/shared/lib/asset-cdn.ts). Leave unset to serve these from
# public/ directly, which is the default and works fine locally.
NEXT_PUBLIC_ASSET_CDN_URL=
