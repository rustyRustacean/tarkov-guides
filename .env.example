# Required. Liveblocks secret key for collaborative Maps sessions
# (server-only, see src/app/api/maps-session/lib/liveblocks-server.ts).
# Without it the site still runs, but Collaborate sessions and teammate
# position markers won't work. Get one from https://liveblocks.io/dashboard.
LIVEBLOCKS_SECRET_KEY=

# Optional. Static-asset CDN origin for map images and PvP guide videos
# (see src/shared/lib/asset-cdn.ts). Leave unset to serve these from
# public/ directly, which is the default and works fine locally.
NEXT_PUBLIC_ASSET_CDN_URL=
